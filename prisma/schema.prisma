generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid(7)) @db.Uuid
  email                String    @unique @db.VarChar(255)
  password             String
  name                 String?   @db.VarChar(255)
  username             String?   @unique @db.VarChar(50)
  usernameChangedAt    DateTime? @map("username_changed_at") @db.Timestamptz(6)
  birthDate            DateTime? @map("birth_date") @db.Date
  ageVerified          Boolean   @default(false) @map("age_verified")
  ageVerifiedAt        DateTime? @map("age_verified_at") @db.Timestamptz(6)
  emailVerified        Boolean   @default(false) @map("email_verified")
  emailVerifiedAt      DateTime? @map("email_verified_at") @db.Timestamptz(6)
  termsAccepted        Boolean   @default(false) @map("terms_accepted")
  termsAcceptedAt      DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  socialProvider       String?   @map("social_provider") @db.VarChar(50)
  socialProviderId     String?   @map("social_provider_id") @db.VarChar(255)
  googleId             String?   @map("google_id") @db.VarChar(255)
  emailNotifications   Boolean   @default(true) @map("email_notifications")
  /// URL pública da imagem no CDN da Cloudflare. A API nunca guarda o binário.
  avatarUrl            String?   @map("avatar_url")
  bio                  String?
  authorVerified       Boolean   @default(false) @map("author_verified")
  authorFounder        Boolean   @default(false) @map("author_founder")
  founderRequestStatus String?   @map("founder_request_status") @db.VarChar(20)
  founderRequestedAt   DateTime? @map("founder_requested_at") @db.Timestamptz(6)
  founderGrantedAt     DateTime? @map("founder_granted_at") @db.Timestamptz(6)
  isAdmin              Boolean   @default(false) @map("is_admin")
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamptz(6)
  isTest               Boolean   @default(false) @map("is_test")
  tourVersion          Int       @default(0) @map("tour_version")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fanfics                   Fanfic[]                   @relation("FanficAuthor")
  fanficsDeleted            Fanfic[]                   @relation("FanficDeletedBy")
  fanficsHidden             Fanfic[]                   @relation("FanficHiddenBy")
  storyCoauthors            StoryCoauthor[]
  storyTeamMessages         StoryTeamMessage[]
  storyTeamNotes            StoryTeamNote[]
  library                   UserLibrary[]
  readingProgress           UserReadingProgress[]
  readingLists              ReadingList[]
  ratings                   StoryRating[]
  followers                 AuthorFollower[]           @relation("Follower")
  following                 AuthorFollower[]           @relation("Author")
  notifications             Notification[]
  refreshTokens             RefreshToken[]
  socialAccounts            UserSocialAccount[]
  chapterComments           ChapterComment[]
  commentLikes              CommentLike[]
  chapterVotes              ChapterVote[]
  commentReports            CommentReport[]
  paragraphComments         ParagraphComment[]
  paragraphCommentReactions ParagraphCommentReaction[]
  conversationWallPosts     AuthorConversationPost[]   @relation("AuthorConversationProfile")
  conversationWrittenPosts  AuthorConversationPost[]   @relation("AuthorConversationWriter")
  storyReports              StoryReport[]
  userReportsMade           UserReport[]               @relation("Reporter")
  userReportsReceived       UserReport[]               @relation("Reported")
  adminAuditLogs            AdminAuditLog[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  emailChangeTokens         EmailChangeToken[]

  @@index([googleId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  pendingEmail String   @map("pending_email") @db.VarChar(255)
  tokenHash    String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("email_verification_tokens")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  fanfics   Fanfic[]

  @@map("categories")
}

model Fanfic {
  id                   String    @id @default(uuid(7)) @db.Uuid
  title                String
  synopsis             String?
  content              String?
  categoryId           String?   @map("category_id") @db.Uuid
  authorName           String?   @map("author_name") @db.VarChar(255)
  authorId             String?   @map("author_id") @db.Uuid
  language             String    @default("PT") @db.VarChar(50)
  originalLanguage     String?   @map("original_language") @db.VarChar(10)
  translationOfStoryId String?   @map("translation_of_story_id") @db.Uuid
  status               String    @default("EM_ANDAMENTO") @db.VarChar(20)
  ageRating            String    @default("LIVRE") @map("age_rating") @db.VarChar(10)
  archiveWarnings      String[]  @default([]) @map("archive_warnings")
  copyrightStatus      String    @default("Todos os direitos reservados") @map("copyright_status") @db.VarChar(100)
  coverUrl             String?   @map("cover_url")
  mainTag              String?   @map("main_tag") @db.VarChar(80)
  featuredOriginal     Boolean   @default(false) @map("featured_original")
  views                Int       @default(0)
  viewsCount           Int       @default(0) @map("views_count")
  effectiveViews       Int       @default(0) @map("effective_views")
  followersCount       Int       @default(0) @map("followers_count")
  chaptersCount        Int       @default(0) @map("chapters_count")
  votesCount           Int       @default(0) @map("votes_count")
  libraryCount         Int       @default(0) @map("library_count")
  commentsCount        Int       @default(0) @map("comments_count")
  ratingsCount         Int       @default(0) @map("ratings_count")
  ratingAverage        Decimal   @default(0) @map("rating_average") @db.Decimal(4, 2)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy            String?   @map("deleted_by") @db.Uuid
  hiddenAt             DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenBy             String?   @map("hidden_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  author             User?                 @relation("FanficAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  categoryRef        Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  deletedByUser      User?                 @relation("FanficDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  hiddenByUser       User?                 @relation("FanficHiddenBy", fields: [hiddenBy], references: [id], onDelete: SetNull)
  originalStory      Fanfic?               @relation("Translations", fields: [translationOfStoryId], references: [id], onDelete: SetNull)
  translations       Fanfic[]              @relation("Translations")
  chapters           Chapter[]
  tags               StoryTag[]
  libraryItems       UserLibrary[]
  readingProgress    UserReadingProgress[]
  readingListStories ReadingListStory[]
  ratings            StoryRating[]
  reports            StoryReport[]
  dailyViews         StoryViewDaily[]
  trendingExposures  TrendingExposure[]
  coauthors          StoryCoauthor[]
  teamMessages       StoryTeamMessage[]
  teamNotes          StoryTeamNote[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([translationOfStoryId])
  @@index([deletedAt])
  @@index([hiddenAt])
  @@index([effectiveViews(sort: Desc)])
  @@index([chaptersCount(sort: Desc)])
  @@index([votesCount(sort: Desc)])
  @@index([libraryCount(sort: Desc)])
  @@index([commentsCount(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@map("fanfics")
}

model StoryCoauthor {
  id        String   @id @default(uuid(7)) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId, status])
  @@index([userId, status])
  @@map("story_coauthors")
}

model StoryTeamMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt(sort: Desc)])
  @@map("story_team_messages")
}

model StoryTeamNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.Text
  pinned    Boolean  @default(false)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, resolved, pinned, createdAt(sort: Desc)])
  @@map("story_team_notes")
}

model StoryViewDaily {
  id         String   @id @default(uuid(7)) @db.Uuid
  storyId    String   @map("story_id") @db.Uuid
  day        DateTime @map("day") @db.Date
  viewsCount Int      @default(0) @map("views_count")

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, day])
  @@index([day, viewsCount(sort: Desc)])
  @@map("story_view_daily")
}

model TrendingExposure {
  id         String    @id @default(uuid(7)) @db.Uuid
  storyId    String    @map("story_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)
  position   Int
  score      Float
  snapshotAt DateTime  @default(now()) @map("snapshot_at") @db.Timestamptz(6)

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, startedAt(sort: Desc)])
  @@index([endedAt])
  @@map("trending_exposures")
}

model Chapter {
  id                   String    @id @default(uuid(7)) @db.Uuid
  storyId              String    @map("story_id") @db.Uuid
  chapterNumber        Int       @map("chapter_number")
  title                String    @db.VarChar(255)
  content              String
  authorNoteBefore     String?   @map("author_note_before")
  authorNoteAfter      String?   @map("author_note_after")
  showAuthorNoteBefore Boolean   @default(false) @map("show_author_note_before")
  showAuthorNoteAfter  Boolean   @default(false) @map("show_author_note_after")
  viewsCount           Int       @default(0) @map("views_count")
  isPublished          Boolean   @default(true) @map("is_published")
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  commentsCount        Int       @default(0) @map("comments_count")
  votesCount           Int       @default(0) @map("votes_count")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  story             Fanfic             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  comments          ChapterComment[]
  paragraphComments ParagraphComment[]
  votes             ChapterVote[]

  @@unique([storyId, chapterNumber])
  @@index([publishedAt])
  @@map("chapters")
}

model Tag {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String     @db.VarChar(255)
  slug      String     @unique @db.VarChar(255)
  type      String     @default("trope") @db.VarChar(50)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  stories   StoryTag[]

  @@map("tags")
}

model StoryTag {
  storyId   String   @map("story_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@map("story_tags")
}

model UserLibrary {
  id      String   @id @default(uuid(7)) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  storyId String   @map("story_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("user_library")
}

model UserReadingProgress {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  storyId         String    @map("story_id") @db.Uuid
  currentChapter  Int       @default(0) @map("current_chapter")
  totalChapters   Int       @default(0) @map("total_chapters")
  progressPercent Int       @default(0) @map("progress_percent")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  lastReadAt      DateTime  @default(now()) @map("last_read_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("user_reading_progress")
}

model StoryRating {
  id        String   @id @default(uuid(7)) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_ratings")
}

model ReadingList {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories ReadingListStory[]

  @@index([userId])
  @@map("reading_lists")
}

model ReadingListStory {
  id            String   @id @default(uuid(7)) @db.Uuid
  readingListId String   @map("reading_list_id") @db.Uuid
  storyId       String   @map("story_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  readingList ReadingList @relation(fields: [readingListId], references: [id], onDelete: Cascade)
  story       Fanfic      @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([readingListId, storyId])
  @@index([storyId])
  @@map("reading_list_stories")
}

model AuthorFollower {
  id         String   @id @default(uuid(7)) @db.Uuid
  followerId String   @map("follower_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  author   User @relation("Author", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([followerId, authorId])
  @@map("author_followers")
}

model Notification {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  message    String
  link       String?  @db.VarChar(255)
  isRead     Boolean  @default(false) @map("is_read")
  groupKey   String?  @map("group_key") @db.VarChar(255)
  groupCount Int      @default(1) @map("group_count")
  actorIds   Json     @default("[]") @map("actor_ids")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model RefreshToken {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(128)
  replacedByTokenHash String?   @map("replaced_by_token_hash") @db.VarChar(128)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(6)
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSocialAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("user_social_accounts")
}

model AuthorConversationPost {
  id        String    @id @default(uuid(7)) @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  body      String    @db.Text
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profileAuthor User                     @relation("AuthorConversationProfile", fields: [authorId], references: [id], onDelete: Cascade)
  user          User                     @relation("AuthorConversationWriter", fields: [userId], references: [id], onDelete: Cascade)
  parent        AuthorConversationPost?  @relation("ConversationReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       AuthorConversationPost[] @relation("ConversationReplies")

  @@index([authorId, createdAt])
  @@index([authorId, pinned, createdAt])
  @@index([parentId])
  @@map("author_conversation_posts")
}

model ChapterComment {
  id           String    @id @default(uuid(7)) @db.Uuid
  chapterId    String    @map("chapter_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  content      String
  language     String?   @db.VarChar(10)
  likesCount   Int       @default(0) @map("likes_count")
  reportsCount Int       @default(0) @map("reports_count")
  isTest       Boolean   @default(false) @map("is_test")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  chapter Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ChapterComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ChapterComment[] @relation("CommentReplies")
  likes   CommentLike[]
  reports CommentReport[]

  @@index([createdAt])
  @@map("chapter_comments")
}

model CommentLike {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isTest    Boolean  @default(false) @map("is_test")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  comment ChapterComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model ChapterVote {
  id        String   @id @default(uuid(7)) @db.Uuid
  chapterId String   @map("chapter_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chapterId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("chapter_votes")
}

model CommentReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  commentId  String    @map("comment_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  reason     String?
  status     String    @default("pending") @db.VarChar(20)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  comment ChapterComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_reports")
}

/// Comentários por parágrafo (v1) — fetch sob demanda por paragraph_id.
model ParagraphComment {
  id          String    @id @default(uuid(7)) @db.Uuid
  chapterId   String    @map("chapter_id") @db.Uuid
  paragraphId String    @map("paragraph_id") @db.VarChar(64)
  userId      String    @map("user_id") @db.Uuid
  content     String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  chapter   Chapter                    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions ParagraphCommentReaction[]

  @@index([chapterId, paragraphId])
  @@index([chapterId, paragraphId, deletedAt])
  @@map("paragraph_comments")
}

model ParagraphCommentReaction {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  comment ParagraphComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("paragraph_comment_reactions")
}

model StoryReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  storyId    String    @map("story_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  reason     String?
  status     String    @default("pending") @db.VarChar(20)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  story Fanfic @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_reports")
}

model UserReport {
  id             String    @id @default(uuid(7)) @db.Uuid
  reportedUserId String    @map("reported_user_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  reason         String?
  status         String    @default("pending") @db.VarChar(20)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  reportedUser User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter     User @relation("Reporter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportedUserId, userId])
  @@map("user_reports")
}

model AdminAuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  action    String   @db.VarChar(120)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("admin_audit_logs")
}

/**
 * Doações / Pix (Mercado Pago) — alimenta a meta mensal da página Apoiar.
 */
model Donation {
  id                String    @id @default(uuid(7)) @db.Uuid
  provider          String    @default("mercadopago") @db.VarChar(40)
  providerPaymentId String    @unique @map("provider_payment_id") @db.VarChar(64)
  status            String    @db.VarChar(40)
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("BRL") @db.VarChar(8)
  paymentMethod     String?   @map("payment_method") @db.VarChar(40)
  payerEmail        String?   @map("payer_email") @db.VarChar(255)
  description       String?   @db.VarChar(500)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  rawPayload        Json?     @map("raw_payload")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, paidAt])
  @@index([provider, status])
  @@map("donations")
}

model SchemaMigration {
  filename  String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}
