NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/fanficando?schema=public"

# JWT — mínimo 16 caracteres (32 em produção)
JWT_SECRET=local-dev-jwt-secret-do-not-use-in-prod
JWT_ACCESS_EXPIRES_IN=15m
# O refresh token é opaco (não é JWT): só o TTL é configurável.
JWT_REFRESH_EXPIRES_IN=7d
JWT_PROFILE_COMPLETION_EXPIRES_IN=30m
JWT_ISSUER=fanficando-api
JWT_AUDIENCE=fanficando-app
# Assina o cookie age_ack (180 dias). Se vazio, usa JWT_SECRET — defina em
# produção para poder rotacionar o JWT_SECRET sem derrubar o age-gate.
AGE_ACK_SECRET=

# CORS e links de e-mail
FRONTEND_URL=http://localhost:5173
# CORS multi-origin (produção): lista separada por vírgula.
# FRONTEND_URL e FRONTEND_URLS também entram na lista.
ALLOWED_ORIGINS=https://fanficando.com,https://www.fanficando.com,https://fanficando.vercel.app,http://localhost:5173
# Alias legado v1 (também suportado)
FRONTEND_URLS=

# Cookies (produção com front em domínio diferente do API, ex.: Vercel + VPS)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.fanficando.com
# COOKIE_AGE_ACK_MAX_AGE_MS=15552000000

# Login/cadastro Google usa o ID token (POST /api/auth/google/token).
# Aceita lista separada por vírgula (web + apps).
GOOGLE_CLIENT_ID=seu_google_client_id

# E-mail (Resend) — sem RESEND_API_KEY nenhum e-mail é enviado (ok no dev)
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM="Fanficando <no-reply@fanficando.com>"
# Logo no topo dos e-mails. Padrão: <FRONTEND_URL>/logo.png
# EMAIL_LOGO_URL=https://www.fanficando.com/logo.png

# Hosts aceitos em avatarUrl (a API só guarda a URL da imagem na Cloudflare).
# O host do R2_PUBLIC_URL entra automaticamente. Aceita "*.host" para subdomínio.
# Sem configuração vale o padrão: imagedelivery.net,*.r2.dev
# AVATAR_ALLOWED_HOSTS=imagedelivery.net,*.r2.dev
# R2_PUBLIC_URL=https://cdn.seudominio.com
