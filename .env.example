PORT=3001
DATABASE_URL=postgresql://SEU_USUARIO@localhost:5432/fanficando_v2_local
# Com senha: postgresql://USUARIO:SENHA@localhost:5432/fanficando_v2_local
JWT_SECRET=local-dev-jwt-secret-do-not-use-in-prod
JWT_ACCESS_EXPIRES_IN=15m
# O refresh token é opaco (não é JWT): só o TTL é configurável.
JWT_REFRESH_EXPIRES_IN=7d
JWT_PROFILE_COMPLETION_EXPIRES_IN=30m
JWT_ISSUER=fanficando-api
JWT_AUDIENCE=fanficando-app
# Assina o cookie age_ack (180 dias). Se vazio, usa JWT_SECRET — defina em
# produção para poder rotacionar o JWT_SECRET sem derrubar o age-gate.
AGE_ACK_SECRET=
FRONTEND_URL=http://localhost:5173
# CORS multi-origin (produção): lista separada por vírgula
ALLOWED_ORIGINS=https://fanficando.com,https://www.fanficando.com,https://fanficando.vercel.app,http://localhost:5173
# Alias legado v1 (também suportado)
FRONTEND_URLS=
# Retenção da lixeira (dias) — alias STORY_SOFT_DELETE_RETENTION_DAYS também aceito
SOFT_DELETE_RETENTION_DAYS=30
NODE_ENV=development

# Cookies (produção com front em domínio diferente do API, ex.: Vercel + VPS)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.fanficando.com
# Aliases legados: AUTH_COOKIE_SECURE, AUTH_COOKIE_SAMESITE, AUTH_COOKIE_DOMAIN
# COOKIE_AGE_ACK_MAX_AGE_MS=15552000000

# E-mail (Resend) — avisos de novo capítulo na biblioteca (opcional no dev)
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM="Fanficando <no-reply@fanficando.com>"
EMAIL_SYNOPSIS_MAX_LENGTH=320
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
# Login/cadastro Google usa o ID token (POST /api/auth/google/token). O client id pode ser uma lista separada por vírgula (web + apps).

# Mercado Pago (Apoiar / Pix) — NÃO commitar o .env real
# Credenciais: https://www.mercadopago.com.br/developers/panel/app
# Use o Access Token de TESTE no local e o de PRODUÇÃO no servidor.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: validação de webhooks (quando houver cobranças via API)
# MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do webhook (produção), ex.: https://api.fanficando.com/api/webhooks/mercadopago
# MERCADOPAGO_WEBHOOK_URL=
# Meta mensal da página Apoiar (R$)
SUPPORTER_MONTHLY_GOAL=525
# (Opcional) Valor de referência legado; o front não pré-preenche mais.
# SUPPORTER_PIX_AMOUNT=2.99
# Valor mínimo aceito no Pix (R$)
SUPPORTER_PIX_MIN_AMOUNT=1
# URL pública da API (produção), usada no notification_url do MP
# PUBLIC_API_URL=https://api.fanficando.com

# Storage: local (dev), r2 (produção) ou cloudinary (legado)
STORAGE_PROVIDER=local
STORAGE_PUBLIC_URL=http://localhost:3001
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Cloudflare R2 — capas, avatares e imagens de capítulo
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://cdn.seudominio.com

# Origem pública das imagens Open Graph (produção). Em local, deixe vazio (usa o próprio host).
# OG_IMAGE_BASE_URL=https://api.fanficando.com
